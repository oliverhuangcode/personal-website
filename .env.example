# Copy to .env.local (or .env) and fill in. Both are gitignored; never commit real values.
# Full setup steps: docs/food.md

# ── Cloudflare R2 (npm run photos) ─────────────────────────────────────────
# R2 overview page → Account ID
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create Account API token (Object Read & Write, bucket oh-media only)
# Use the S3 "Access Key ID" and "Secret Access Key", not the token value.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oh-media

# ── Google Sheet (npm run food:sync) ───────────────────────────────────────
# File → Share → Publish to web → your tab → Comma-separated values (.csv)
# Also add the same URL as the GitHub repo secret FOOD_SHEET_CSV_URL for the daily sync.
FOOD_SHEET_CSV_URL=
